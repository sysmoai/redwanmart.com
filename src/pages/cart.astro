---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@components/ui/Button";
---

<BaseLayout>
  <section class="container mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-8">Your Cart</h1>

    <div id="cart-container" class="max-w-2xl">
      <p class="text-rm-neutral-500">Loading cart...</p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const container = document.getElementById("cart-container");

  function renderCart() {
    let cart = [];
    try { cart = JSON.parse(localStorage.getItem("rm-cart") || "[]"); } catch (e) {}

    if (cart.length === 0) {
      container.innerHTML = `
        <div class="text-center py-16">
          <p class="text-6xl mb-4">🛒</p>
          <p class="text-xl text-rm-neutral-600 mb-4">Your cart is empty</p>
          <a href="/shop" class="inline-flex items-center gap-2 rounded-lg bg-rm-brand-red px-6 py-3 text-sm font-semibold text-white hover:bg-rm-brand-red-hover transition-colors">Start Shopping</a>
        </div>`;
      return;
    }

    const total = cart.reduce((sum, i) => sum + i.price * i.quantity, 0);

    container.innerHTML = `
      <div class="space-y-4 mb-8">
        ${cart.map((item, idx) => `
          <div class="flex items-center gap-4 p-4 rounded-xl border border-gray-200">
            <img src="${item.image}" alt="${item.title}" class="w-20 h-20 object-cover rounded-lg bg-rm-neutral-100" />
            <div class="flex-1 min-w-0">
              <h3 class="font-semibold text-sm truncate">${item.title}</h3>
              <p class="text-rm-brand-red font-bold text-sm mt-1">৳${item.price.toLocaleString()}</p>
            </div>
            <div class="flex items-center gap-2">
              <button onclick="updateQty(${idx}, -1)" class="w-8 h-8 rounded-lg border text-sm font-semibold hover:bg-gray-50">−</button>
              <span class="w-8 text-center text-sm font-medium">${item.quantity}</span>
              <button onclick="updateQty(${idx}, 1)" class="w-8 h-8 rounded-lg border text-sm font-semibold hover:bg-gray-50">+</button>
            </div>
            <button onclick="removeItem(${idx})" class="text-red-500 hover:text-red-700 p-2">✕</button>
          </div>
        `).join("")}
      </div>
      <div class="border-t pt-6 flex items-center justify-between">
        <p class="text-lg font-bold">Total: <span class="text-rm-brand-red">৳${total.toLocaleString()}</span></p>
        <a href="/checkout" class="inline-flex items-center gap-2 rounded-lg bg-rm-brand-gold px-6 py-3 text-sm font-semibold text-rm-neutral-900 hover:bg-rm-brand-gold-dark transition-colors">Proceed to Checkout →</a>
      </div>`;
  }

  function updateQty(index, delta) {
    let cart = [];
    try { cart = JSON.parse(localStorage.getItem("rm-cart") || "[]"); } catch (e) {}
    if (cart[index]) {
      cart[index].quantity += delta;
      if (cart[index].quantity <= 0) cart.splice(index, 1);
    }
    localStorage.setItem("rm-cart", JSON.stringify(cart));
    window.dispatchEvent(new Event("cart-updated"));
    renderCart();
  }

  function removeItem(index) {
    let cart = [];
    try { cart = JSON.parse(localStorage.getItem("rm-cart") || "[]"); } catch (e) {}
    cart.splice(index, 1);
    localStorage.setItem("rm-cart", JSON.stringify(cart));
    window.dispatchEvent(new Event("cart-updated"));
    renderCart();
  }

  renderCart();
</script>
