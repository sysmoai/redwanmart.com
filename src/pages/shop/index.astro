---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProductCard from "@components/shop/ProductCard.astro";

const sampleProducts = [
  { id: 1, slug: "premium-wireless-earbuds", title: "Premium Wireless Earbuds", price: 2499, description: "High-quality wireless earbuds with noise cancellation", images: ["https://placehold.co/400x400/EC1713/FFFFFF?text=Earbuds"], category_id: 1, stock: 50 },
  { id: 2, slug: "classic-cotton-tshirt", title: "Classic Cotton T-Shirt", price: 799, description: "100% cotton, comfortable fit for everyday wear", images: ["https://placehold.co/400x400/FFB805/000000?text=TShirt"], category_id: 2, stock: 100 },
  { id: 3, slug: "smart-led-bulb", title: "Smart LED Bulb", price: 1299, description: "WiFi-enabled smart bulb with app control", images: ["https://placehold.co/400x400/16A34A/FFFFFF?text=Bulb"], category_id: 3, stock: 75 },
  { id: 4, slug: "organic-face-cream", title: "Organic Face Cream", price: 549, description: "Natural ingredients for glowing skin", images: ["https://placehold.co/400x400/EC1713/FFFFFF?text=Cream"], category_id: 4, stock: 200 },
  { id: 5, slug: "yoga-mat-premium", title: "Premium Yoga Mat", price: 1899, description: "Non-slip, eco-friendly yoga mat", images: ["https://placehold.co/400x400/FFB805/000000?text=Yoga"], category_id: 5, stock: 30 },
  { id: 6, slug: "bestseller-novel-set", title: "Bestseller Novel Set", price: 699, description: "Collection of top-rated novels", images: ["https://placehold.co/400x400/16A34A/FFFFFF?text=Books"], category_id: 6, stock: 60 },
  { id: 7, slug: "kids-building-blocks", title: "Kids Building Blocks", price: 999, description: "Creative building blocks for children", images: ["https://placehold.co/400x400/EC1713/FFFFFF?text=Toys"], category_id: 7, stock: 40 },
  { id: 8, slug: "organic-honey-jar", title: "Organic Honey Jar", price: 449, description: "Pure organic honey from local farms", images: ["https://placehold.co/400x400/FFB805/000000?text=Honey"], category_id: 8, stock: 150 },
];
---

<BaseLayout>
  <section class="container mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-center mb-2">All Products</h1>
    <p class="text-rm-neutral-500 text-center mb-10">Browse our complete collection</p>

    <!-- Search Bar -->
    <div class="max-w-md mx-auto mb-10">
      <input
        type="text"
        placeholder="Search products..."
        class="w-full h-11 rounded-lg border border-gray-300 px-4 text-sm focus:outline-none focus:ring-2 focus:ring-rm-brand-red focus:border-transparent"
        id="search-input"
      />
    </div>

    <!-- Product Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      {sampleProducts.map((product) => <ProductCard product={product} />)}
    </div>
  </section>
</BaseLayout>

<script>
  document.getElementById("search-input")?.addEventListener("input", (e) => {
    const query = (e.target as HTMLInputElement).value.toLowerCase();
    document.querySelectorAll("[data-product-card]").forEach((card) => {
      const title = card.getAttribute("data-title")?.toLowerCase() || "";
      (card as HTMLElement).style.display = title.includes(query) ? "" : "none";
    });
  });
</script>
