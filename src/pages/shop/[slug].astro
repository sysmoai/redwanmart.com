---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Button } from "@components/ui/Button";

const allProducts = [
  { id: 1, slug: "premium-wireless-earbuds", title: "Premium Wireless Earbuds", price: 2499, description: "Experience crystal-clear audio with these premium wireless earbuds. Features active noise cancellation, 30-hour battery life, and comfortable ergonomic design. Perfect for music lovers and professionals.", images: ["https://placehold.co/600x600/EC1713/FFFFFF?text=Earbuds"], category_id: 1, stock: 50 },
  { id: 2, slug: "classic-cotton-tshirt", title: "Classic Cotton T-Shirt", price: 799, description: "100% cotton, comfortable fit for everyday wear. Perfect for casual outings and lounging.", images: ["https://placehold.co/600x600/FFB805/000000?text=TShirt"], category_id: 2, stock: 100 },
  { id: 3, slug: "smart-led-bulb", title: "Smart LED Bulb", price: 1299, description: "WiFi-enabled smart bulb with app control and 16 million colors. Compatible with Alexa and Google Home.", images: ["https://placehold.co/600x600/16A34A/FFFFFF?text=Bulb"], category_id: 3, stock: 75 },
  { id: 4, slug: "organic-face-cream", title: "Organic Face Cream", price: 549, description: "Natural ingredients for glowing, healthy skin. Made with organic aloe vera, vitamin E, and essential oils.", images: ["https://placehold.co/600x600/EC1713/FFFFFF?text=Cream"], category_id: 4, stock: 200 },
  { id: 5, slug: "yoga-mat-premium", title: "Premium Yoga Mat", price: 1899, description: "Non-slip, eco-friendly yoga mat with carrying strap. 6mm thick for comfort, perfect for home and studio use.", images: ["https://placehold.co/600x600/FFB805/000000?text=Yoga"], category_id: 5, stock: 30 },
  { id: 6, slug: "bestseller-novel-set", title: "Bestseller Novel Set", price: 699, description: "Collection of top-rated novels — 5 books in one set. Great for gifting and personal libraries.", images: ["https://placehold.co/600x600/16A34A/FFFFFF?text=Books"], category_id: 6, stock: 60 },
  { id: 7, slug: "kids-building-blocks", title: "Kids Building Blocks", price: 999, description: "Creative building blocks set for children ages 3+. Develops motor skills and creativity with 150+ pieces.", images: ["https://placehold.co/600x600/EC1713/FFFFFF?text=Toys"], category_id: 7, stock: 40 },
  { id: 8, slug: "organic-honey-jar", title: "Organic Honey Jar", price: 449, description: "Pure organic honey sourced from local farms. 500g jar of natural golden honey, no additives.", images: ["https://placehold.co/600x600/FFB805/000000?text=Honey"], category_id: 8, stock: 150 },
];

const { slug } = Astro.params;
const product = allProducts.find(p => p.slug === slug);

if (!product) {
  return Astro.redirect("/shop");
}
---

<BaseLayout>
  <section class="container mx-auto px-4 py-12">
    <a href="/shop" class="text-sm text-rm-brand-red hover:underline mb-6 inline-block">&larr; Back to Shop</a>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      <div class="aspect-square rounded-xl bg-rm-neutral-100 overflow-hidden">
        <img src={product.images[0]} alt={product.title} class="w-full h-full object-cover" />
      </div>
      <div>
        <p class="text-sm text-rm-neutral-400 mb-1">Redwan Mart</p>
        <h1 class="text-3xl font-bold text-rm-neutral-900 mb-3">{product.title}</h1>
        <p class="text-2xl font-bold text-rm-brand-red mb-6">৳{product.price.toLocaleString()}</p>
        <p class="text-rm-neutral-600 leading-relaxed mb-6">{product.description}</p>
        <p class="text-sm text-rm-neutral-400 mb-4">
          {product.stock > 0 ? <span class="text-rm-success font-medium">{product.stock} in stock</span> : "Out of stock"}
        </p>
        <div class="flex gap-4">
          <Button variant="primary" size="lg" id="add-to-cart" class="flex-1">Add to Cart</Button>
          <Button variant="gold" size="lg" id="buy-now" class="flex-1">Buy Now</Button>
        </div>
        <div class="mt-8 border-t pt-6">
          <h3 class="font-semibold mb-2">Delivery</h3>
          <p class="text-sm text-rm-neutral-500">Fast delivery across Bangladesh. Free shipping on orders over ৳5,000.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  const productData = {
    productId: {product.id},
    slug: "{product.slug}",
    title: "{product.title}",
    price: {product.price},
    image: "{product.images[0]}",
  };

  document.getElementById("add-to-cart")?.addEventListener("click", () => {
    let cart = [];
    try { cart = JSON.parse(localStorage.getItem("rm-cart") || "[]"); } catch (e) {}
    const existing = cart.find(i => i.productId === productData.productId);
    if (existing) existing.quantity += 1;
    else cart.push({ ...productData, quantity: 1 });
    localStorage.setItem("rm-cart", JSON.stringify(cart));
    window.dispatchEvent(new Event("cart-updated"));
  });

  document.getElementById("buy-now")?.addEventListener("click", () => {
    document.getElementById("add-to-cart")?.click();
    window.location.href = "/cart";
  });
</script>
