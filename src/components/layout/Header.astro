---
import { Button } from "@components/ui/Button";
import { Input } from "@components/ui/Input";
---

<header class="sticky top-0 z-50 w-full border-b bg-white/95 backdrop-blur supports-[backdrop-filter]:bg-white/80">
  <div class="container mx-auto flex h-16 items-center justify-between px-4">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 font-bold text-xl">
      <img src="/brand/logo.svg" alt="Redwan Mart" class="h-8 w-auto" />
      <span class="hidden sm:inline text-rm-brand-red">Redwan Mart</span>
    </a>

    <!-- Nav -->
    <nav class="hidden md:flex items-center gap-6">
      <a href="/shop" class="text-sm font-medium text-rm-neutral-600 hover:text-rm-brand-red transition-colors">Shop</a>
      <a href="/categories" class="text-sm font-medium text-rm-neutral-600 hover:text-rm-brand-red transition-colors">Categories</a>
      <a href="/about" class="text-sm font-medium text-rm-neutral-600 hover:text-rm-brand-red transition-colors">About</a>
    </nav>

    <!-- Right -->
    <div class="flex items-center gap-3">
      <a href="/cart" class="relative p-2 text-rm-neutral-600 hover:text-rm-brand-red transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
        <span id="cart-count" class="absolute -top-0.5 -right-0.5 flex h-4 w-4 items-center justify-center rounded-full bg-rm-brand-red text-[10px] font-bold text-white hidden">0</span>
      </a>
      <script>
        function updateCartCount() {
          const el = document.getElementById("cart-count");
          if (!el) return;
          try {
            const cart = JSON.parse(localStorage.getItem("rm-cart") || "[]");
            const count = cart.reduce((s, i) => s + i.quantity, 0);
            if (count > 0) { el.textContent = String(count); el.classList.remove("hidden"); }
            else { el.classList.add("hidden"); }
          } catch {}
        }
        updateCartCount();
        window.addEventListener("cart-updated", updateCartCount);
      </script>
    </div>
  </div>
</header>
